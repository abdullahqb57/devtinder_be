{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch DevTinder Backend",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/src/app.js",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "env": {
        "NODE_ENV": "development"
      },
      "skipFiles": ["<node_internals>/**"],
      "autoAttachChildProcesses": true
    }
  ]
}
